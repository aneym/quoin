{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quoin.local/manifest.schema.json",
  "version": 1,
  "type": "object",
  "required": ["format_version", "slug", "title", "brand", "language", "governing_question", "privacy", "sources", "movements", "blocks"],
  "properties": {
    "format_version": {"const": 1}, "slug": {"type": "string"}, "title": {"type": "string"}, "brand": {"type": "string"}, "language": {"type": "string"}, "governing_question": {"type": "string"},
    "privacy": {"type": "object", "required": ["forbidden_terms"], "properties": {"forbidden_terms": {"type": "array", "items": {"type": "string"}}}},
    "sources": {"type": "array", "items": {"type": "object", "required": ["id", "type", "locator"], "properties": {"id": {"type": "string"}, "type": {"enum": ["web", "epub", "file"]}, "locator": {"type": "string"}, "chapter_locator": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]}, "rights": {"type": "object"}}}},
    "movements": {"type": "array", "items": {"type": "object", "required": ["id", "title", "items"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "items": {"type": "array", "items": {"type": "object", "required": ["ref"], "properties": {"ref": {"type": "string", "pattern": "^(source|block):"}}}}}}},
    "blocks": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "brief", "evidence"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["title_deck", "introduction", "interlude", "cover_copy"]}, "brief": {"type": "string"}, "evidence": {"type": "array"}}}}
  }
}
