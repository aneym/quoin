{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": 2,
  "type": "object",
  "required": [
    "block_id",
    "kind",
    "title",
    "html"
  ],
  "properties": {
    "block_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "title_deck",
        "introduction",
        "interlude",
        "cover_copy",
        "lesson",
        "exercise",
        "answer",
        "debrief"
      ]
    },
    "title": {
      "type": "string"
    },
    "html": {
      "type": "string"
    }
  }
}
